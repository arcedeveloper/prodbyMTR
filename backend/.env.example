# Copiá este archivo como .env y completá los valores.
# En Render, cargá las mismas variables en Environment.

# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Neon (cadena de conexión de tu base)
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# Dirección donde está publicada la tienda, sin barra al final
FRONTEND_URL=https://arcedeveloper.github.io/prodbyMTR

# Otras direcciones permitidas, separadas por coma (opcional)
ALLOWED_ORIGINS=

# Mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=matirodas50@gmail.com
MAIL_FROM_NAME=ProdByMTR
AVISO_VENTAS_EMAIL=matirodas50@gmail.com

# Panel /admin (usuario y contraseña para entrar)
ADMIN_USER=admin
ADMIN_PASSWORD=
